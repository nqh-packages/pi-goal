{
  "name": "@qhn/pi-goal",
  "version": "0.4.1",
  "description": "Setup-first autonomous goal mode extension for Pi.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nqh-packages/pi-goal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nqh-packages/pi-goal.git"
  },
  "bugs": {
    "url": "https://github.com/nqh-packages/pi-goal/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "goal",
    "goal-mode",
    "autonomous-agent",
    "status-line",
    "agent"
  ],
  "files": [
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "assets/",
    "extensions/",
    "tests/",
    "messages.test.ts"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts messages.test.ts",
    "test:ui": "GOAL_UI_CAPTURE=1 node --import tsx --test --test-name-pattern \"terminal capture\" tests/*.test.ts",
    "verify:pi": "pi --offline --no-extensions --extension ./extensions/goal.ts --version",
    "verify:package": "pi --offline --no-extensions --extension . --version",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "tsx": "^4.21.0",
    "typebox": "^1.1.37"
  },
  "pi": {
    "extensions": [
      "./extensions/goal.ts"
    ],
    "image": "https://unpkg.com/@qhn/pi-goal@0.2.0/assets/pi-goal-status.png"
  }
}
